{
  "manifest_version": 3,
  "name": "Hiraku Judges Translator",
  "version": "0.2.0",
  "description": "One-click translation of problem statements on Codeforces, AtCoder, CSES, UVa, SPOJ and other judges - including PDF statements. TeX formulas, code and samples are never touched.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hiraku Judges Translator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "*://codeforces.com/*",
    "*://*.codeforces.com/*",
    "*://codeforc.es/*",
    "*://atcoder.jp/*",
    "*://cses.fi/*",
    "*://open.kattis.com/*",
    "*://www.spoj.com/*",
    "*://spoj.com/*",
    "*://acm.timus.ru/*",
    "*://dmoj.ca/*",
    "*://www.acmicpc.net/*",
    "*://leetcode.com/*",
    "*://vjudge.net/*",
    "*://onlinejudge.org/*",
    "*://*.onlinejudge.org/*",
    "*://icpcarchive.ecs.baylor.edu/*",
    "*://qoj.ac/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*",
        "*://codeforc.es/*",
        "*://atcoder.jp/*",
        "*://cses.fi/*",
        "*://open.kattis.com/*",
        "*://www.spoj.com/*",
        "*://spoj.com/*",
        "*://acm.timus.ru/*",
        "*://dmoj.ca/*",
        "*://www.acmicpc.net/*",
        "*://leetcode.com/*",
        "*://vjudge.net/*",
        "*://onlinejudge.org/*",
        "*://*.onlinejudge.org/*",
        "*://icpcarchive.ecs.baylor.edu/*",
        "*://qoj.ac/*"
      ],
      "js": [
        "shared/i18n.js",
        "shared/core.js",
        "content/adapters.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate the page / show the original"
    }
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "reader/*",
        "shared/*",
        "vendor/pdfjs/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
