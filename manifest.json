{
  "manifest_version": 3,
  "name": "Judge Translate",
  "version": "0.1.0",
  "description": "One-click translation of problem statements on Codeforces, AtCoder, CSES and other judges. TeX formulas, code and samples are never touched.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Judge Translate",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://codeforces.com/*",
        "*://*.codeforces.com/*",
        "*://codeforc.es/*",
        "*://atcoder.jp/*",
        "*://cses.fi/*",
        "*://open.kattis.com/*",
        "*://www.spoj.com/*",
        "*://acm.timus.ru/*",
        "*://dmoj.ca/*",
        "*://www.acmicpc.net/*",
        "*://leetcode.com/*",
        "*://vjudge.net/*"
      ],
      "js": [
        "shared/i18n.js",
        "shared/core.js",
        "content/adapters.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Translate the page / show the original"
    }
  }
}